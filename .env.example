# MakersFlow Web — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Backend API ────────────────────────────────────────────────────────────────
# NestJS Backend API URL (MakersFlow Backend)
VITE_API_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Web Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# ── Supabase (Database & Storage) ──────────────────────────────────────────────
# Shared database and asset storage
VITE_SUPABASE_URL=https://oodqutwsljhvuyotuthu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Alias accepted by the Supabase client if VITE_SUPABASE_PUBLISHABLE_KEY is not set:
# VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Publishable key only — safe to expose in the browser.
VITE_RAZORPAY_KEY_ID=rzp_test_<your-key-id>
